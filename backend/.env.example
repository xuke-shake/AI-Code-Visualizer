APP_NAME=AI Code Visualizer Backend
APP_ENV=dev
DEBUG=true
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_FILES=2000
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LLM_ENABLED=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=4000
MAX_ZIP_MEMBER_UNCOMPRESSED_SIZE_MB=10
MAX_ZIP_TOTAL_UNCOMPRESSED_SIZE_MB=100
MAX_ZIP_COMPRESSION_RATIO=100
GIT_COMMAND_TIMEOUT_SECONDS=120
GIT_LOW_SPEED_SECONDS=30
GIT_MAX_SNAPSHOT_FILES=10000
GIT_MAX_SNAPSHOT_SIZE_MB=500
GIT_MAX_SNAPSHOT_FILE_SIZE_MB=50
